NODE_ENV=development
APP_PORT=8000
PORT=8000
JWT_KEY=xxxxxxxxxxxxxxxxx
JWT_EXP=1d
APP_IV=xxxxxxxxxxxxxxxx
APP_SIGNATURE_KEY=xxxxxxxxxxxx

DB_USER=postgres
