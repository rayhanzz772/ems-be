SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Set true saat menjalankan test atau proses yang tidak boleh menjadwalkan cron.
DISABLE_JOBS=false

# Permohonan cuti yang tidak diputuskan atasan selama N hari naik ke HR.
LEAVE_ESCALATION_DAYS=3

